{
  "name": "proekciya",
  "version": "2.1.0",
  "private": true,
  "description": "Проекция: 3D-фигура по меркам, скан по фото, подбор размера одежды",
  "scripts": {
    "vendor": "node scripts/fetch-vendor.mjs",
    "serve": "node scripts/serve.mjs",
    "android:init": "node scripts/fetch-vendor.mjs && npx cap add android && node scripts/android-setup.mjs && npx cap sync android",
    "android:sync": "node scripts/fetch-vendor.mjs && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:aab": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": ">=6.0.1",
    "@capacitor-community/text-to-speech": ">=4.1.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@mediapipe/tasks-vision": "0.10.14"
  },
  "engines": {
    "node": ">=22"
  }
}